CREATE A CSS FOLDER THEN USE THE FOLLOWING CODE :



*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Poppins',sans-serif;
}

html{
scroll-behavior:smooth;
}

body{

background:#0f172a;
color:white;
overflow-x:hidden;

}

nav{

position:fixed;
top:0;
width:100%;
padding:20px 8%;
display:flex;
justify-content:space-between;
align-items:center;

background:rgba(255,255,255,.05);

backdrop-filter:blur(20px);

z-index:1000;
}

.logo {

    font-size: 1.8rem;
    font-weight: 700;

    background: linear-gradient(
        45deg,
        #38bdf8,
        #8b5cf6
    );

    background-clip: text;          /* Standard */
    -webkit-background-clip: text;  /* Chrome/Safari */

    -webkit-text-fill-color: transparent;
    color: transparent;
}

nav ul{
display:flex;
gap:30px;
list-style:none;
}

nav a{
color:white;
text-decoration:none;
}

.hero{

height:100vh;

display:flex;
justify-content:center;
align-items:center;
text-align:center;

background:
linear-gradient(
135deg,
#0f172a,
#1e293b
);
}

.hero h1 {

    font-size: 5rem;

    background: linear-gradient(
        90deg,
        #38bdf8,
        #8b5cf6
    );

    background-clip: text;          /* Standard property */
    -webkit-background-clip: text;  /* Chrome, Safari */

    -webkit-text-fill-color: transparent;
    color: transparent;
}

.hero p{
max-width:700px;
margin:20px auto;
font-size:1.1rem;
}

.btn{

display:inline-block;

padding:14px 35px;

border-radius:50px;

background:
linear-gradient(
45deg,
#38bdf8,
#8b5cf6
);

text-decoration:none;
color:white;
margin-top:20px;
}

.search-section{

padding:60px 10%;
text-align:center;
}

#searchBox{

width:100%;
max-width:700px;

padding:18px;

border:none;

border-radius:50px;

font-size:1rem;
}

.blog-container{

padding:50px 10%;

display:grid;

grid-template-columns:
repeat(auto-fit,minmax(320px,1fr));

gap:35px;
}

.blog-card{

background:#1e293b;

border-radius:20px;

overflow:hidden;

transition:.4s;
}

.blog-card:hover{

transform:
translateY(-12px)
scale(1.03);

box-shadow:
0 25px 50px rgba(139,92,246,.3);
}

.blog-card img{

width:100%;
height:220px;
object-fit:cover;
}

.card-content{
padding:25px;
}

.card-content h2{
margin:15px 0;
}

.card-content a{

color:#38bdf8;

text-decoration:none;

font-weight:600;
}

footer{

padding:50px;
text-align:center;
}

.blog-page{

padding:120px 12%;
max-width:1000px;
margin:auto;
}

.featured{

width:100%;
border-radius:20px;
margin-bottom:30px;
}

.date{

margin:20px 0;
color:#94a3b8;
}

.contact{

padding:150px 10%;
}

form{

display:flex;
flex-direction:column;
gap:20px;
}

input,
textarea{

padding:18px;

border:none;

border-radius:15px;
}

button{

padding:18px;

border:none;

border-radius:15px;

background:
linear-gradient(
45deg,
#38bdf8,
#8b5cf6
);

color:white;

cursor:pointer;
}
.hidden{
opacity:0;
transform:translateY(80px);
transition:1s;
}
/* LIGHT MODE */

.light{
background:white;
color:#111;
}

.light .blog-card{
background:white;
color:black;
}

.light nav{
background:rgba(255,255,255,.8);
}

/* MOBILE MENU */

.menu-btn{
display:none;
font-size:1.5rem;
cursor:pointer;
}

.show-menu{
display:flex !important;
}

/* FILTERS */

.filters{
display:flex;
justify-content:center;
gap:15px;
padding-bottom:40px;
flex-wrap:wrap;
}

.filter-btn{
padding:12px 25px;
border:none;
border-radius:50px;
cursor:pointer;
}

.active{
background:#8b5cf6;
color:white;
}

/* TOP BUTTON */

#topBtn{

position:fixed;
right:25px;
bottom:25px;

width:50px;
height:50px;

border:none;

border-radius:50%;

display:none;
justify-content:center;
align-items:center;

cursor:pointer;

z-index:1000;
}

/* ANIMATED BACKGROUND */

.gradient-bg{

position:fixed;

width:100%;
height:100%;

background:
radial-gradient(
circle at top left,
rgba(139,92,246,.25),
transparent 40%
),

radial-gradient(
circle at bottom right,
rgba(56,189,248,.25),
transparent 40%
);

z-index:-1;
}

/* MOBILE */

@media(max-width:768px){

.menu-btn{
display:block;
}

.nav-links{

display:none;

position:absolute;

top:80px;
right:20px;

flex-direction:column;

padding:20px;

background:#1e293b;

border-radius:15px;
}

.hero h1{
font-size:3rem;
}

}
nav{
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;

    display: flex;
    justify-content: space-between;
    align-items: center;

    padding: 20px 8%;

    background: rgba(15,23,42,.8);
    backdrop-filter: blur(15px);

    z-index: 1000;
}

.logo{
    font-size: 1.8rem;
    font-weight: 700;
}

.nav-links{
    display: flex;
    align-items: center;
    gap: 30px;   /* THIS creates spacing */
}

.nav-links a{
    color: white;
    text-decoration: none;
    font-weight: 500;
    transition: .3s;
}

.nav-links a:hover{
    color: #38bdf8;
}
.show{
opacity:1;
transform:translateY(0);
}
@media(max-width:768px){

.hero h1{
font-size:3rem;
}

nav ul{
display:none;
}

}
